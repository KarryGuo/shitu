# ===== Web =====
PORT_WEB=5179
VITE_API_BASE=/api

# ===== API =====
PORT=8787
WEB_ORIGIN=http://localhost:5173,http://localhost:5199

# 状态持久化（演示为 JSON 落盘；生产换 Turso/libSQL）
DATA_DIR=./data
# 演示节奏（步骤间隔毫秒，0 = 全速，用于测试）
CARE_PACE=600

# 确认单
CONFIRM_SECRET=change-me-in-prod
CONFIRM_TTL_SEC=120

# LLM 适配器：rule（默认，规则链路）| dashscope（需下方 Key）
LLM_PROVIDER=rule
LLM_MODEL=qwen-plus
LLM_VL_MODEL=qwen-vl-max
DASHSCOPE_API_KEY=

# ===== 预留（架构 §9 适配器位，复赛按需接入） =====
# 数据库：libsql://xxx.turso.io（生产）/ file:./data/shitu.db（本地）/ :memory:（测试）
DATABASE_URL=file:./data/shitu.db
TURSO_AUTH_TOKEN=
JWT_SECRET=
CRON_SECRET=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shitu
RESEND_API_KEY=

# 高德开放平台（周边充电/加油/洗车搜索；未配置则返回演示数据，配置后同接口自动切换实时）
# 注意：需「Web服务」类型的 Key（restapi.amap.com）；「Web端(JS API)」Key 会报 USERKEY_PLAT_NOMATCH
AMAP_KEY=
# 数字签名私钥（可选；高德控制台开启「数字签名」后必填，请求自动携带 sig）
AMAP_SIG=
