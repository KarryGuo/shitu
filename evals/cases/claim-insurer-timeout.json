{
  "id": "claim-insurer-timeout",
  "name": "理赔闭环 · 保险/门店平台超时 → 缓存方案降级，任务仍完成",
  "scenario": "claim",
  "inject": "insurer_timeout",
  "actions": [
    { "type": "wait", "status": "waiting" },
